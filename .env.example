# Copy this file to .env and fill in your values:  cp .env.example .env

# Google Gemini API key — get a free one at https://aistudio.google.com/apikey
GOOGLE_GENAI_API_KEY=your_key_here

# PostgreSQL (used by Docker Compose to initialize the database container)
POSTGRES_DB=wordwizard
POSTGRES_USER=wordwizard
POSTGRES_PASSWORD=change_me

# Connection settings for running the app locally (IntelliJ / gradlew run).
# Inside Docker these are overridden by docker-compose.yml.
DB_URL=jdbc:postgresql://localhost:5432/wordwizard
DB_USERNAME=wordwizard
DB_PASSWORD=change_me
